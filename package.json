{
  "name": "art-gallery-management",
  "private": true,
  "description": "Art Gallery Management System — Techstack test task (backend: NestJS, frontend: React)",
  "scripts": {
    "prepare": "husky",
    "typecheck:backend": "cd backend && npx tsc --noEmit",
    "test:backend": "cd backend && npm run test -- --passWithNoTests",
    "build:backend": "cd backend && npm run build",
    "typecheck:frontend": "cd frontend && npx tsc --noEmit",
    "check:frontend": "cd frontend && npm run check:ci",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "backend/**/*.{ts,json}": [
      "bash -c 'cd backend && npx biome check --write --no-errors-on-unmatched --files-ignore-unknown=true'"
    ],
    "frontend/**/*.{ts,tsx,json}": [
      "bash -c 'cd frontend && npx biome check --write --no-errors-on-unmatched --files-ignore-unknown=true'"
    ]
  }
}
